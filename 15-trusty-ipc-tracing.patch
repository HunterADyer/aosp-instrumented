 #define LOCAL_TRACE 0
 
+/*
+ * TEE IPC tracing — logs all normal world ↔ TA communication.
+ * Output goes to Trusty log buffer → /dev/trusty-log0 on normal world.
+ *
+ * Every connect, send, recv, and disconnect is logged with:
+ *   - Service name (TA port name, e.g. "com.android.trusty.keymint")
+ *   - Message size
+ *   - Client ID (maps to normal world process)
+ *   - Timestamp (Trusty timer ticks)
+ *   - Result code
+ *
+ * Controlled by APKTRACE_TEE_IPC — set to 1 to enable.
+ */
+#define APKTRACE_TEE_IPC 1
+
+#if APKTRACE_TEE_IPC
+#include <platform.h>
+
+#define TEE_TRACE(fmt, ...) \
+    printf("[TEE_IPC] %llu " fmt "\n", current_time_ns() / 1000000ULL, ##__VA_ARGS__)
+#else
+#define TEE_TRACE(fmt, ...) do {} while(0)
+#endif
+
 /*
  *  Max number of sync tipc devices
  */
@@ -357,6 +381,10 @@ static int dev_connect(struct ql_tipc_dev* dev,
