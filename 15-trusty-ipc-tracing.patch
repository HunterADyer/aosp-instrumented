+
+    TEE_TRACE("CONNECT port=\"%s\" client=0x%" PRIx64 " rc=%d",
+              (const char*)req.body, dev->client_id, rc);
+
     if (rc != NO_ERROR) {
         TRACEF("failed to open ipc channel: %d\n", rc);
         return set_status(dev, opcode, rc, 0);
@@ -422,6 +450,8 @@ static long dev_disconnect(struct ql_tipc_dev* dev, uint32_t target) {
