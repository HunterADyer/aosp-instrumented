+
+package com.android.server.apktrace;
+
+import android.content.Context;
+import android.util.Slog;
+
+import com.android.server.SystemService;
+
+/**
+ * System service that initializes APK framework tracing.
+ *
+ * Reads configuration from system properties on start. No-op if
+ * {@code persist.apktrace.enabled} is "0".
+ *
+ * @hide
+ */
+public class ApkTraceService extends SystemService {
+
+    private static final String TAG = "ApkTraceService";
+
+    public ApkTraceService(Context context) {
+        super(context);
+    }
+
+    @Override
+    public void onStart() {
+        if (!ApkTraceConfig.isEnabled()) {
+            Slog.i(TAG, "ApkTrace disabled (persist.apktrace.enabled != 1)");
+            return;
+        }
+        Slog.i(TAG, "ApkTrace starting, loading config...");
+        ApkTraceConfig.reload();
+        Slog.i(TAG, "ApkTrace ready");
+    }
+
+    @Override
+    public void onBootPhase(int phase) {
+        // Reload config at PHASE_BOOT_COMPLETED in case properties were
+        // set late by an init script.
+        if (phase == SystemService.PHASE_BOOT_COMPLETED) {
+            if (ApkTraceConfig.isEnabled()) {
+                ApkTraceConfig.reload();
+            }
+        }
+    }
+}
