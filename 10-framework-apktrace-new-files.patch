+
+package com.android.server.apktrace;
+
+import android.util.Slog;
+
+import java.io.File;
+import java.io.FileOutputStream;
+import java.io.IOException;
+import java.nio.charset.StandardCharsets;
+
+/**
+ * Static utility class for writing APK trace events as JSON lines.
+ *
+ * Output goes to {@code /data/local/tmp/apktrace/<pkg>/framework.jsonl},
+ * using O_APPEND for atomic line writes. Every public method guards on
+ * {@link ApkTraceConfig#isEnabled()} so callers do not need to re-check.
+ *
+ * Valid categories: "lifecycle", "provider", "pm", "location", "account".
+ *
+ * @hide
+ */
+public final class ApkTraceLogger {
+
+    private static final String TAG = "ApkTraceLogger";
+    private static final String BASE_DIR = "/data/local/tmp/apktrace";
+
+    private ApkTraceLogger() {}
+
+    /**
+     * Quick check that can be inlined at call sites to avoid any argument
+     * evaluation when tracing is globally off.
+     */
+    public static boolean isEnabled() {
+        return ApkTraceConfig.isEnabled();
+    }
+
+    /**
+     * Log a trace event as a JSON line.
+     *
+     * @param category one of "lifecycle", "provider", "pm", "location", "account"
+     * @param event    short event name, e.g. "broadcast", "query"
+     * @param pkg      the package name this event pertains to
+     * @param kvPairs  alternating key, value strings to include in the JSON
+     */
+    public static void log(String category, String event, String pkg, String... kvPairs) {
+        if (!ApkTraceConfig.isEnabled()) return;
+        if (pkg == null || !ApkTraceConfig.isTraced(pkg)) return;
+
+        final StringBuilder sb = new StringBuilder(256);
+        sb.append("{\"ts\":").append(System.currentTimeMillis());
+        sb.append(",\"cat\":\"").append(escapeJson(category));
+        sb.append("\",\"event\":\"").append(escapeJson(event));
+        sb.append("\",\"pkg\":\"").append(escapeJson(pkg)).append('"');
+        if (kvPairs != null && kvPairs.length >= 2) {
+            for (int i = 0; i + 1 < kvPairs.length; i += 2) {
+                final String k = kvPairs[i];
+                final String v = kvPairs[i + 1];
+                if (k != null && v != null) {
+                    sb.append(",\"").append(escapeJson(k)).append("\":\"");
+                    sb.append(escapeJson(v)).append('"');
+                }
+            }
+        }
+        sb.append("}\n");
+
+        writeLine(pkg, sb.toString());
+    }
+
+    private static void writeLine(String pkg, String line) {
+        final File dir = new File(BASE_DIR, pkg);
+        if (!dir.exists() && !dir.mkdirs()) {
+            Slog.w(TAG, "Failed to create trace dir: " + dir.getAbsolutePath());
+            return;
+        }
+        final File file = new File(dir, "framework.jsonl");
+        try (FileOutputStream fos = new FileOutputStream(file, true /* append */)) {
+            fos.write(line.getBytes(StandardCharsets.UTF_8));
+        } catch (IOException e) {
+            Slog.w(TAG, "Failed to write trace for " + pkg + ": " + e.getMessage());
+        }
+    }
+
+    /**
+     * Minimal JSON string escaping — handles the characters that would break
+     * a JSON string value. We avoid pulling in a full JSON library for this
+     * performance-sensitive path.
+     */
+    private static String escapeJson(String s) {
+        if (s == null) return "";
+        final int len = s.length();
+        final StringBuilder sb = new StringBuilder(len + 8);
+        for (int i = 0; i < len; i++) {
+            final char c = s.charAt(i);
+            switch (c) {
+                case '"':  sb.append("\\\""); break;
+                case '\\': sb.append("\\\\"); break;
+                case '\n': sb.append("\\n");  break;
+                case '\r': sb.append("\\r");  break;
+                case '\t': sb.append("\\t");  break;
+                default:   sb.append(c);      break;
+            }
+        }
+        return sb.toString();
+    }
+}
