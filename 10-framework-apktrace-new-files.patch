+package com.android.server.apktrace;
+
+import android.os.SystemProperties;
+import android.text.TextUtils;
+
+import java.util.Collections;
+import java.util.HashSet;
+import java.util.Set;
+
+/**
+ * Configuration for APK framework tracing.
+ *
+ * Reads traced package list from system property {@code persist.apktrace.packages}
+ * (comma-separated) and provides O(1) lookup for whether a given package is being traced.
+ *
+ * @hide
+ */
+public class ApkTraceConfig {
+
+    private static final String PROP_PACKAGES = "persist.apktrace.packages";
+    private static final String PROP_ENABLED = "persist.apktrace.enabled";
+
+    // Guarded by sLock
+    private static final Object sLock = new Object();
+    private static volatile Set<String> sTracedPackages = Collections.emptySet();
+
+    private ApkTraceConfig() {}
+
+    /**
+     * Reload the traced package set from the system property.
+     * Called on service startup and when the property changes.
+     */
+    public static void reload() {
+        final String raw = SystemProperties.get(PROP_PACKAGES, "");
+        final Set<String> pkgs = new HashSet<>();
+        if (!TextUtils.isEmpty(raw)) {
+            for (String token : raw.split(",")) {
+                final String trimmed = token.trim();
+                if (!trimmed.isEmpty()) {
+                    pkgs.add(trimmed);
+                }
+            }
+        }
+        synchronized (sLock) {
+            sTracedPackages = pkgs;
+        }
+    }
+
+    /**
+     * Returns true if tracing is globally enabled via {@code persist.apktrace.enabled}.
+     */
+    public static boolean isEnabled() {
+        return !"0".equals(SystemProperties.get(PROP_ENABLED, "0"));
+    }
+
+    /**
+     * O(1) check whether the given package is in the traced set.
+     * Returns false if tracing is globally disabled or pkg is null.
+     */
+    public static boolean isTraced(String pkg) {
+        if (pkg == null) return false;
+        return sTracedPackages.contains(pkg);
+    }
+
+    /**
+     * Add a package to the traced set and persist to system property.
+     */
+    public static void addPackage(String pkg) {
+        if (TextUtils.isEmpty(pkg)) return;
+        synchronized (sLock) {
+            final Set<String> updated = new HashSet<>(sTracedPackages);
+            updated.add(pkg);
+            sTracedPackages = updated;
+            persistLocked(updated);
+        }
+    }
+
+    /**
+     * Remove a package from the traced set and persist to system property.
+     */
+    public static void removePackage(String pkg) {
+        if (TextUtils.isEmpty(pkg)) return;
+        synchronized (sLock) {
+            final Set<String> updated = new HashSet<>(sTracedPackages);
+            if (updated.remove(pkg)) {
+                sTracedPackages = updated;
+                persistLocked(updated);
+            }
+        }
+    }
+
+    private static void persistLocked(Set<String> pkgs) {
+        SystemProperties.set(PROP_PACKAGES, TextUtils.join(",", pkgs));
+    }
+}
