+
+/// Logs a key operation (begin) to logcat for APK tracing.
+pub fn log_key_operation(calling_uid: u32, key_id: i64, purpose: &str, algorithm: &str) {
+    log::info!(target: "ApkTraceTEE",
+        "{{\"ts\":{},\"c\":\"tee\",\"e\":\"key_op\",\"uid\":{},\"key\":{},\"purpose\":\"{}\",\"alg\":\"{}\"}}",
+        std::time::SystemTime::now().duration_since(std::time::UNIX_EPOCH).unwrap_or_default().as_millis(),
+        calling_uid, key_id, purpose, algorithm);
+}
+
+/// Logs an attestation request to logcat for APK tracing.
+pub fn log_attestation_request(calling_uid: u32, key_id: i64, challenge_len: usize) {
+    log::info!(target: "ApkTraceTEE",
+        "{{\"ts\":{},\"c\":\"tee\",\"e\":\"attestation\",\"uid\":{},\"key\":{},\"challenge_len\":{}}}",
+        std::time::SystemTime::now().duration_since(std::time::UNIX_EPOCH).unwrap_or_default().as_millis(),
+        calling_uid, key_id, challenge_len);
+}
