+/// Logs a key operation (begin) to logcat for APK tracing.
+pub fn log_key_operation(calling_uid: u32, key_id: i64, purpose: &str, algorithm: &str) {
+    log::info!(target: "ApkTraceTEE",
+        "{{\"ts\":{},\"c\":\"tee\",\"e\":\"key_op\",\"uid\":{},\"key\":{},\"purpose\":\"{}\",\"alg\":\"{}\"}}",
+        std::time::SystemTime::now().duration_since(std::time::UNIX_EPOCH).unwrap_or_default().as_millis(),
+        calling_uid, key_id, purpose, algorithm);
+}
+
+/// Logs an attestation request to logcat for APK tracing.
+pub fn log_attestation_request(calling_uid: u32, key_id: i64, challenge_len: usize) {
+    log::info!(target: "ApkTraceTEE",
+        "{{\"ts\":{},\"c\":\"tee\",\"e\":\"attestation\",\"uid\":{},\"key\":{},\"challenge_len\":{}}}",
+        std::time::SystemTime::now().duration_since(std::time::UNIX_EPOCH).unwrap_or_default().as_millis(),
+        calling_uid, key_id, challenge_len);
+}
+
+/// Attestation extension OID: 1.3.6.1.4.1.11129.2.1.17
+/// DER-encoded OID value bytes (after tag 0x06 and length): 10 bytes
+const ATTESTATION_OID: &[u8] = &[0x2b, 0x06, 0x01, 0x04, 0x01, 0xd6, 0x79, 0x02, 0x01, 0x11];
+
+/// Patch the attestation certificate's RootOfTrust to report a locked, verified device.
+///
+/// The RootOfTrust structure in the attestation extension contains:
+///   SEQUENCE {
+///     verifiedBootKey      OCTET STRING,   -- 32 bytes
+///     deviceLocked         BOOLEAN,        -- TRUE (01 01 ff) or FALSE (01 01 00)
+///     verifiedBootState    ENUMERATED,     -- 0=Verified, 1=SelfSigned, 2=Unverified
+///     verifiedBootHash     OCTET STRING,   -- 32 bytes
+///   }
+///
+/// We find the attestation extension OID, then scan forward for the RootOfTrust
+/// pattern and patch:
+///   - deviceLocked: FALSE (0x00) → TRUE (0xFF)
+///   - verifiedBootState: Unverified (0x02) → Verified (0x00)
+pub fn patch_attestation_cert(cert_der: &mut [u8]) -> bool {
+    // Find the attestation extension OID
+    let oid_pos = match cert_der
+        .windows(ATTESTATION_OID.len())
+        .position(|w| w == ATTESTATION_OID)
+    {
+        Some(pos) => pos,
+        None => return false, // No attestation extension found
+    };
+
+    // From the OID position, search forward for the RootOfTrust SEQUENCE.
+    // After the verifiedBootKey (OCTET STRING, typically 32 bytes), we expect:
+    //   BOOLEAN tag (0x01), length (0x01), value (0x00 or 0xFF)
+    //   ENUMERATED tag (0x0A), length (0x01), value (0x00-0x03)
+    //
+    // We scan for the pattern: 0x01 0x01 XX 0x0A 0x01 XX
+    // where the BOOLEAN is followed by ENUMERATED.
+    let search_start = oid_pos;
+    let search_end = std::cmp::min(cert_der.len(), oid_pos + 512);
+
+    for i in search_start..search_end.saturating_sub(6) {
+        if cert_der[i] == 0x01          // BOOLEAN tag
+            && cert_der[i + 1] == 0x01  // BOOLEAN length = 1
+            && cert_der[i + 3] == 0x0A  // ENUMERATED tag
+            && cert_der[i + 4] == 0x01  // ENUMERATED length = 1
+        {
+            let old_locked = cert_der[i + 2];
+            let old_state = cert_der[i + 5];
+
+            // Only patch if this looks like the right location
+            // (deviceLocked should be 0x00=false or 0xFF=true,
+            //  verifiedBootState should be 0-3)
+            if old_state <= 3 {
+                // Patch deviceLocked to TRUE
+                cert_der[i + 2] = 0x01; // BOOLEAN TRUE
+
+                // Patch verifiedBootState to Verified (0)
+                cert_der[i + 5] = 0x00;
+
+                log::info!(target: "ApkTraceTEE",
+                    "{{\"ts\":{},\"c\":\"tee\",\"e\":\"attestation_patched\",\
+                    \"locked\":\"{:#04x}->{:#04x}\",\"state\":\"{}->{}\",\"offset\":{}}}",
+                    std::time::SystemTime::now()
+                        .duration_since(std::time::UNIX_EPOCH)
+                        .unwrap_or_default()
+                        .as_millis(),
+                    old_locked, 0x01u8,
+                    old_state, 0u8,
+                    i);
+
+                return true;
+            }
+        }
+    }
+
+    false
+}
